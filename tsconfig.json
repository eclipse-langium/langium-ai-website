{
  // Twoslash typechecks every `ts twoslash` block against this config and the
  // pinned npm packages. Kept close to langium-ai's tsconfig.base.json so the
  // gated docs surface matches how the library is actually consumed.
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  // this config exists to drive twoslash's per-block typecheck, not to compile a
  // project; `files: []` keeps a bare `tsc` invocation from erroring on no inputs.
  "files": []
}
